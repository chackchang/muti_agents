# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv-*

# 环境变量（可能含密钥）
.env

# 模型缓存（约 2GB，不入库）
.hf_cache/

# 抓取调试产物
.tmp/
debug*.html
auth.json

# PDF/视觉提取产物（MinerU/Docling 抽出的图片，可重新生成）
documents/.vision_assets*/

# 入库 / 导出生成物
exported_documents/

# pytest 临时目录
pytest-of-magic/

# 运行日志
*.log
